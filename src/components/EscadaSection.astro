---
const { t } = Astro.props
const e = t.escada
---

<section class="secao" id="metodo">
  <div class="wrap">
    <p class="t-kicker">{e.kicker}</p>
    <h2 class="t-h2 mt-3">{e.titulo}</h2>
    <p class="t-lead mt-4 max-w-[40ch]">{e.lead}</p>

    <!-- Quatro degraus, deslocados como a junta do símbolo. Cada um entra quando aparece na tela (CSS, sem JS). -->
    <ol class="escada mt-12 md:mt-16">
      {
        e.degraus.map((d, i) => (
          <li class="degrau" style={`--i: ${i}`}>
            <span class="degrau-rotulo">
              {i > 0 && <span class="degrau-sinal" aria-hidden="true">≠</span>}
              {d.rotulo}
            </span>
            <p class="degrau-texto">{d.texto}</p>
          </li>
        ))
      }
    </ol>

    <p class="regra mt-12 md:mt-16">
      {e.regra} <strong class="t-mono regra-marca">{e.regraMarca}</strong>
    </p>
  </div>
</section>

<style>
  .escada {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .degrau {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 0 1.4rem 1.5rem;
    border-left: 2px solid var(--ebl-acento);
    border-top: 1px solid var(--ebl-regua);
  }

  .degrau:first-child {
    border-top-color: transparent;
  }

  .degrau-rotulo {
    font-family: var(--ebl-mono);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .degrau-sinal {
    color: var(--ebl-acento);
    font-weight: 400;
  }

  .degrau-texto {
    color: var(--ebl-tinta-suave);
    max-width: 44ch;
    text-wrap: pretty;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .degrau {
      margin-inline-start: calc(var(--i) * 11%);
      padding: 1.6rem 0 1.6rem 2rem;
    }
  }

  .regra {
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.7rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 30ch;
    text-wrap: balance;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ebl-regua);
  }

  .regra-marca {
    color: var(--ebl-acento);
    font-size: 0.8em;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Entrada ligada à rolagem; só onde o navegador suporta e o visitante não pediu menos movimento. */
  @keyframes degrau-entra {
    from { opacity: 0.15; transform: translateX(-0.75rem); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .degrau {
        animation: degrau-entra linear both;
        animation-timeline: view();
        animation-range: entry 5% entry 45%;
      }
    }
  }
</style>
