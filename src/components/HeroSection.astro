---
import Simbolo from './Simbolo.astro'

const { t } = Astro.props
const h = t.heroi
---

<!-- Herói. Frase A do briefing [PROP] 18/09/2026 — o Owner escolhe entre A e B. -->
<section class="secao heroi">
  <div class="wrap heroi-grid">
    <figure class="heroi-simbolo" aria-hidden="true">
      <Simbolo size="100%" title="" />
      <canvas class="heroi-canvas"></canvas>
    </figure>

    <div class="heroi-texto">
      <h1 class="t-display">
        {h.linha1}<br />
        <span class="t-acento">{h.linha2}</span>
      </h1>

      <p class="t-lead heroi-sub">{h.sub}</p>

      <a class="btn heroi-cta" href={h.ctaHref}>
        {h.cta}
        <span class="seta" aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  .heroi {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .heroi-grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  .heroi-simbolo {
    margin: 0;
    position: relative;
    width: clamp(6.5rem, 30vw, 9rem);
    aspect-ratio: 1;
  }

  .heroi-simbolo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .heroi-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .heroi-texto {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 38ch;
  }

  .heroi-sub {
    max-width: 34ch;
  }

  .heroi-cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .heroi {
      padding-top: clamp(2rem, 5vw, 4.5rem);
      min-height: calc(100svh - 6.5rem);
      display: flex;
      align-items: center;
    }

    .heroi-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }

    .heroi-simbolo {
      order: 2;
      width: min(100%, 27rem);
      justify-self: end;
    }

    .heroi-texto {
      order: 1;
      max-width: 44rem;
      gap: 1.75rem;
    }
  }
</style>

<script>
  // Movimento leve: pontos do complementar percorrendo a junta do símbolo.
  // Desligado em prefers-reduced-motion, fora da tela e com a aba escondida.
  const fig = document.querySelector<HTMLElement>('.heroi-simbolo')
  const canvas = fig?.querySelector<HTMLCanvasElement>('.heroi-canvas')
  const mq = window.matchMedia('(prefers-reduced-motion: no-preference)')

  if (fig && canvas && mq.matches) {
    const ctx = canvas.getContext('2d')!
    // Linha média da junta, em unidades do símbolo (800 × 800); G = 60, então ±20 fica dentro da junta.
    const traço: [number, number][] = [
      [740, 200],
      [550, 200],
      [550, 400],
      [250, 400],
      [250, 600],
      [60, 600],
    ]
    const seg: { a: [number, number]; b: [number, number]; len: number }[] = []
    let total = 0
    for (let i = 0; i < traço.length - 1; i++) {
      const a = traço[i], b = traço[i + 1]
      const len = Math.hypot(b[0] - a[0], b[1] - a[1])
      seg.push({ a, b, len })
      total += len
    }
    const posAo = (d: number): [number, number, number, number] => {
      let r = ((d % total) + total) % total
      for (const s of seg) {
        if (r <= s.len) {
          const u = r / s.len
          const dx = (s.b[0] - s.a[0]) / s.len, dy = (s.b[1] - s.a[1]) / s.len
          return [s.a[0] + dx * r, s.a[1] + dy * r, -dy, dx]
        }
        r -= s.len
      }
      const s = seg[seg.length - 1]
      return [s.b[0], s.b[1], 0, 0]
    }

    const N = 26
    const pts = Array.from({ length: N }, (_, i) => ({
      d: (i / N) * total + Math.random() * 40,
      v: 28 + Math.random() * 22,
      f: 0.6 + Math.random() * 0.9,
      p: Math.random() * Math.PI * 2,
      r: 3.5 + Math.random() * 3,
    }))

    let cor = '#d7b174'
    const lerCor = () => {
      cor = getComputedStyle(document.documentElement).getPropertyValue('--ebl-acento').trim() || cor
    }
    lerCor()
    new MutationObserver(lerCor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })

    let w = 0, h = 0, dpr = 1
    const medir = () => {
      const r = fig.getBoundingClientRect()
      dpr = Math.min(window.devicePixelRatio || 1, 2)
      w = r.width
      h = r.height
      canvas.width = Math.round(w * dpr)
      canvas.height = Math.round(h * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }
    medir()
    new ResizeObserver(medir).observe(fig)

    let ativo = true, visível = true, raf = 0, ultimo = 0
    const quadro = (ts: number) => {
      raf = 0
      if (!ativo || !visível) return
      const dt = ultimo ? Math.min((ts - ultimo) / 1000, 0.05) : 0
      ultimo = ts
      const k = w / 800
      ctx.clearRect(0, 0, w, h)
      ctx.fillStyle = cor
      for (const q of pts) {
        q.d += q.v * dt
        const [x, y, nx, ny] = posAo(q.d)
        const osc = Math.sin(ts / 1000 * q.f + q.p)
        const off = osc * 14
        const alfa = 0.25 + 0.5 * (0.5 + 0.5 * Math.sin(ts / 1000 * q.f * 1.3 + q.p))
        ctx.globalAlpha = alfa
        ctx.beginPath()
        ctx.arc((x + nx * off) * k, (y + ny * off) * k, q.r * k, 0, Math.PI * 2)
        ctx.fill()
      }
      ctx.globalAlpha = 1
      raf = requestAnimationFrame(quadro)
    }
    const liga = () => {
      if (!raf && ativo && visível) {
        ultimo = 0
        raf = requestAnimationFrame(quadro)
      }
    }

    new IntersectionObserver(([e]) => {
      visível = e.isIntersecting
      liga()
    }).observe(fig)
    document.addEventListener('visibilitychange', () => {
      ativo = !document.hidden
      liga()
    })
    mq.addEventListener('change', () => {
      ativo = mq.matches && !document.hidden
      if (!ativo) ctx.clearRect(0, 0, w, h)
      liga()
    })
    liga()
  }
</script>
