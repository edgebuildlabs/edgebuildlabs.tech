---
import Layout from '../layouts/Layout.astro'
import HeroSection from './HeroSection.astro'
import CaminhosSection from './CaminhosSection.astro'
import ProvaSection from './ProvaSection.astro'
import EscadaSection from './EscadaSection.astro'
import FaixaSection from './FaixaSection.astro'
import ContatoSection from './ContatoSection.astro'

const { t, path, altPath } = Astro.props
---

<Layout t={t} title={t.meta.titulo} description={t.meta.descricao} path={path} altPath={altPath}>
  <HeroSection t={t} />
  <CaminhosSection t={t} />
  <ProvaSection t={t} />
  <EscadaSection t={t} />
  <FaixaSection t={t} />
  <ContatoSection t={t} />
</Layout>
